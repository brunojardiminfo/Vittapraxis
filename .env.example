# Copie para .env e preencha.
#
# Em produção, criar o banco pela aba Storage do Vercel (Neon). A integração
# injeta as duas variáveis abaixo automaticamente no projeto — ninguém precisa
# copiar senha à mão.
#
# DATABASE_URL          → conexão com pooler, usada pelo app em runtime.
# DATABASE_URL_UNPOOLED → conexão direta, usada só para aplicar migrations.
#
# Em desenvolvimento, as duas podem apontar para o mesmo banco. Use uma branch
# separada do Neon para não mexer nos dados de produção.

DATABASE_URL="postgresql://usuario:senha@host/vitapraxis?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/vitapraxis?sslmode=require"
